# Copy to .env and fill in. Never commit .env. Validated by src/lib/env.ts.

# Neon pooled connection string (postgres://...). Required from M0.
DATABASE_URL=

# Google Gemini (required from M2). Model IDs verified 2026-10-11 — see DECISIONS.md D-002/D-003.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
# Requests/minute pacing for Gemini (default 10 for the free tier; raise with billing enabled).
GEMINI_RPM=

# Resend email delivery (required from M7).
RESEND_API_KEY=
EMAIL_FROM=
# Optional: deliver every digest to this address (needed when the sender domain is unverified).
DIGEST_TO=

# Shared secrets: CRON_SECRET guards /api/cron/*, ADMIN_SECRET guards mutating endpoints.
CRON_SECRET=
ADMIN_SECRET=

# Tier 2 news: free key from https://gnews.io (optional; sources report an error without it).
NEWS_API_KEY=

# Daily USD/INR source. Use: https://api.frankfurter.dev/v1
FX_API_URL=

# Public base URL of the deployment, e.g. https://<project>.vercel.app
NEXT_PUBLIC_APP_URL=
